{
  "name": "rexgot-style",
  "version": "1.0.0",
  "description": "A custom Bootstrap-like CSS framework",
  "main": "dist/css/rexgot.min.css",
  "scripts": {
    "css:compile": "sass src/scss/rexgot.scss dist/css/rexgot.css --source-map",
    "css:prefix": "postcss dist/css/rexgot.css -o dist/css/rexgot.css",
    "css:minify": "sass src/scss/rexgot.scss dist/css/rexgot.min.css --style compressed --source-map",
    "js:build": "esbuild src/js/rexgot.js --bundle --outfile=dist/js/rexgot.bundle.js",
    "js:minify": "esbuild src/js/rexgot.js --bundle --minify --outfile=dist/js/rexgot.bundle.min.js",
    "build": "npm-run-all --sequential css:compile css:prefix css:minify js:build js:minify",
    "watch": "sass --watch src/scss:dist/css"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.0",
    "esbuild": "^0.20.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.0",
    "postcss-cli": "^11.0.0",
    "sass": "^1.70.0"
  },
  "scripts": {
  "format": "prettier --write \"**/*.{html,js,json,md,cshtml,css,jsx,tsx,py,java}\"",
  "lint:css": "stylelint \"src/scss/**/*.scss\"",
  "lint:css:fix": "stylelint \"src/scss/**/*.scss\" --fix"
  }
}
